# Configuración del Entorno de Producción para Railway
DEBUG=False
SECRET_KEY=django-insecure-cambia-esta-clave-secreta-en-produccion
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=https://*.railway.app,https://*.up.railway.app

# Conexión a MongoDB (Recomendado: MongoDB Atlas)
# Formato Atlas: mongodb+srv://<usuario>:<password>@cluster0.xxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<usuario>:<password>@<tu-cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=salud_federada
