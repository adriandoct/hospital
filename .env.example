# Configuración del Entorno de Producción para Railway
DEBUG=False
SECRET_KEY=django-insecure-cambia-esta-clave-secreta-en-produccion
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=https://*.railway.app,https://*.up.railway.app

# Conexión a MongoDB (MongoDB Atlas)
MONGO_USER=admin_hospital
MONGO_PASSWORD=12345678Rosario
MONGO_DB_NAME=salud_federada

# Formato de conexión Atlas para Railway (reemplaza <tu-cluster> por el nombre de tu cluster):
# MONGO_URI=mongodb+srv://admin_hospital:12345678Rosario@<tu-cluster>.mongodb.net/salud_federada?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://admin_hospital:12345678Rosario@<tu-cluster>.mongodb.net/salud_federada?retryWrites=true&w=majority

# Base de datos relacional (Opcional - Railway PostgreSQL la inyecta automáticamente si agregas una base Postgres)
# Si no se define, Django usará SQLite
# DATABASE_URL=postgresql://usuario:password@host:port/dbname

